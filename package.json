{
	"name": "ready-room",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "npm run validate:cards && npm run audit:publish && tsc -b && vite build",
		"build:desktop": "npm run validate:cards && npm run audit:publish && tsc -b && vite build --mode desktop",
		"test": "vitest run --project engine-node --project dom",
		"test:all": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src tools server",
		"validate:cards": "tsx tools/validate-cards.ts",
		"authoring": "vite --config tools/authoring/vite.config.ts",
		"server": "tsx server/main.ts",
		"game": "tsx tools/game.ts",
		"server:start": "npm run server",
		"fetch-cards": "tsx tools/fetch-stcc.ts",
		"custom-cards": "tsx tools/custom/render-cards.ts firefly",
		"custom-cards:kit": "tsx tools/custom/build-prompt-kit.ts firefly",
		"custom-cards:desktop": "tsx tools/custom/install-desktop.ts",
		"audit:publish": "tsx tools/audit-publish.ts",
		"bot:check": "tsx tools/bot-check.ts",
		"bot:retrain": "tsx tools/retrain.ts",
		"prepare": "husky",
		"tauri": "tauri",
		"desktop:dev": "tauri dev",
		"desktop:build": "tauri build"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown --ignore-path .prettierignore"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.4",
		"idb-keyval": "^6.3.0",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.12.3",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^5.0.1",
		"eslint": "^10.11.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^16.4.0",
		"prettier": "^3.9.8",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.1"
	}
}
