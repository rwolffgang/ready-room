# The local-only paths below have no trailing slash, so they stay ignored when
# a worktree makes them symlinks into the main checkout.
node_modules
dist/
cards/raw/
cards/ocr/
cards/gaps/
tts/
tools/bin/
venv/
cards/fields/
cards/idzoom/
cards/ops/
cards/spliced/
cards/icon_features.json
__pycache__/
server/data/

# STCC card database, fetched locally by `npm run fetch-cards` (never committed)
vendor/stcc
public/stcc

# Fan-made custom decks: source images downloaded and card faces rendered
# locally by `npm run custom-cards` (tools/custom/) — never committed
vendor/custom
public/custom

# Copyrighted source material (WizKids/CBS) — kept locally, never published:
# OCR card records and reports, rulebook/Cyclopedia PDFs, card image scratch.
/cards/
rules/pdf/
*.pdf
tmp/

# test runner cache
.vitest/
coverage/

# your own Fly.io app config (copy fly.example.toml)
/fly.toml

# house AI self-play records, candidate weights and arena runs (tools/selfplay.ts, tools/retrain.ts)
.bot-data/
# local screenshots from browser checks
.screens/

# games mirrored by the dev server for `npm run game` (vite.config.ts)
.debug/
